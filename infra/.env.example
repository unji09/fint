# F!NT 앱 데이터 스택 환경변수 (로컬 개발용)
# 사용법:
#   1. cp .env.example .env
#   2. 값 조정 (로컬 개발엔 기본값 그대로 써도 됨)
#   3. .env 는 .gitignore 로 제외됨

# ---------- PostgreSQL ----------
POSTGRES_USER=fint
POSTGRES_PASSWORD=fint
POSTGRES_DB=fint_local
POSTGRES_PORT=5432

# ---------- Redis ----------
# 로컬 개발엔 비워두면 비밀번호 없이 기동. 운영은 반드시 강한 값으로 설정.
REDIS_PASSWORD=
REDIS_PORT=6379
