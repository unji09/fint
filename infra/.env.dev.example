# F!NT EC2 배포 환경변수
# 사용법: cp .env.dev.example .env.dev 후 값 채우기
# .env.dev는 .gitignore로 제외됨

# ---------- PostgreSQL ----------
POSTGRES_USER=fint
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=fint_dev
POSTGRES_URL=jdbc:postgresql://postgres:5432/fint_dev

# ---------- Redis ----------
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD
REDIS_HOST=redis
REDIS_PORT=6379

# ---------- JWT ----------
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_STRING
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=1209600000

# ---------- AI Server ----------
AI_SERVER_URL=http://ai:8000

# ---------- AWS S3 ----------
S3_BUCKET=
S3_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---------- CORS ----------
CORS_ALLOWED_ORIGINS=http://localhost:3000
