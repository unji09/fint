# ========================================
# F!NT - 통합 환경변수 (EC2 배포용)
# ========================================
# 사용법:
#   1. 이 파일을 복사: cp .env.dev.example .env.dev
#   2. 실제 운영 값으로 채우기 (CHANGE_ME 항목 필수)
#   3. .env.dev는 절대 커밋하지 않음 (.gitignore 등록됨)

# ---------- PostgreSQL ----------
POSTGRES_USER=fint
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=fint_dev
POSTGRES_URL=jdbc:postgresql://postgres:5432/fint_dev
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---------- Redis ----------
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD
REDIS_HOST=redis
REDIS_PORT=6379

# ---------- JWT ----------
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_STRING
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=1209600000

# ---------- AI Server ----------
AI_SERVER_URL=http://ai:8000
APP_ENV=dev
LOG_LEVEL=INFO
OPENAI_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1
OPENAI_OCR_MODEL=gpt-5-nano

# ---------- AWS S3 ----------
S3_BUCKET=
S3_REGION=ap-northeast-2
S3_KMS_KEY_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---------- CORS ----------
CORS_ALLOWED_ORIGINS=https://k14a301.p.ssafy.io

# ---------- Frontend (빌드타임 주입) ----------
# NEXT_PUBLIC_* 는 빌드 시점에 번들에 박히므로 docker compose 가 아니라
# Jenkins 의 'Build Frontend Image' 스테이지에서 이 파일을 읽어
# --build-arg 로 주입한다 (Jenkinsfile 참고).
NEXT_PUBLIC_API_URL=https://k14a301.p.ssafy.io/api

# ---------- External APIs ----------
DART_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---------- FCM ----------
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=

# ---------- Monitoring (Grafana) ----------
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
