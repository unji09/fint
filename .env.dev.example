# ========================================
# F!NT - 통합 환경변수 (EC2 배포용)
# ========================================
# 사용법:
#   1. 이 파일을 복사: cp .env.dev.example .env.dev
#   2. 실제 운영 값으로 채우기 (CHANGE_ME 항목 필수)
#   3. .env.dev는 절대 커밋하지 않음 (.gitignore 등록됨)

# ---------- PostgreSQL ----------
POSTGRES_USER=fint
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=fint_dev
POSTGRES_URL=jdbc:postgresql://postgres:5432/fint_dev

# ---------- Redis ----------
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD
REDIS_HOST=redis
REDIS_PORT=6379

# ---------- JWT ----------
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_STRING
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=1209600000

# ---------- AI Server ----------
AI_SERVER_URL=http://ai:8000

# ---------- AWS S3 ----------
S3_BUCKET=
S3_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---------- CORS ----------
CORS_ALLOWED_ORIGINS=https://k14a301.p.ssafy.io

# ---------- External APIs ----------
DART_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---------- FCM ----------
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=

# ---------- Monitoring (Grafana) ----------
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
