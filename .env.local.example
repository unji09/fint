# ========================================
# F!NT - 통합 환경변수 (로컬 개발용)
# ========================================
# 사용법:
#   1. 이 파일을 복사: cp .env.local.example .env.local
#   2. 필요 시 값 조정 (기본값 그대로 써도 로컬 개발 가능)
#   3. .env.local은 절대 커밋하지 않음 (.gitignore 등록됨)

# ---------- PostgreSQL ----------
POSTGRES_URL=jdbc:postgresql://localhost:5432/fint_local
POSTGRES_USER=fint
POSTGRES_PASSWORD=fint
POSTGRES_DB=fint_local
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# ---------- Redis ----------
# 로컬 개발엔 비워두면 비밀번호 없이 기동.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- JWT ----------
JWT_SECRET=change-me-to-random-256-bit-base64-key
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=1209600000

# ---------- AI Service (FastAPI) ----------
AI_SERVER_URL=http://localhost:8000
OPENAI_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1
OPENAI_OCR_MODEL=gpt-5-nano

# ---------- AWS S3 ----------
S3_BUCKET=fint-local
S3_REGION=ap-northeast-2
S3_KMS_KEY_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---------- CORS ----------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------- External APIs ----------
DART_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---------- FCM ----------
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=

# ---------- Monitoring (Grafana) ----------
GRAFANA_ADMIN_PASSWORD=changeme
