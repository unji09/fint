# ========================================
# F!NT Backend - 환경변수 예시
# ========================================
# 사용법:
#   1. 이 파일을 복사: cp .env.example .env
#   2. 실제 값 채우기
#   3. .env는 절대 커밋하지 않음 (.gitignore 등록됨)

# ---------- MongoDB ----------
MONGODB_URI=mongodb://localhost:27017/fint_local
MONGODB_DATABASE=fint_local

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- JWT ----------
# 256-bit Base64 인코딩된 시크릿 (openssl rand -base64 32 로 생성)
JWT_SECRET=change-me-to-random-256-bit-base64-key
JWT_ACCESS_EXPIRATION=3600000       # 1시간 (ms)
JWT_REFRESH_EXPIRATION=1209600000   # 14일 (ms)

# ---------- AI Service (FastAPI) ----------
AI_SERVER_URL=http://localhost:8000

# ---------- AWS S3 ----------
S3_BUCKET=fint-local
S3_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---------- CORS ----------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------- External APIs ----------
DART_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---------- FCM ----------
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=
